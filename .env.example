# ─────────────────────────────────────────────────────────────
# Приём заявок в Telegram (основной канал)
# ─────────────────────────────────────────────────────────────
# 1. Создайте бота через @BotFather → команда /newbot → получите токен.
# 2. Добавьте бота в нужный чат/группу и узнайте chat_id (см. README).
TELEGRAM_BOT_TOKEN=123456789:AAExampleBotTokenReplaceMe
TELEGRAM_CHAT_ID=-1001234567890

# ─────────────────────────────────────────────────────────────
# Дублирование заявок на email через SMTP (по умолчанию — Яндекс)
# ─────────────────────────────────────────────────────────────
# Для Яндекс.Почты: host=smtp.yandex.ru, port=465 (SSL).
# SMTP_USER — полный адрес ящика, SMTP_PASS — пароль приложения (не основной!).
SMTP_HOST=smtp.yandex.ru
SMTP_PORT=465
SMTP_USER=zayavki@yourdomain.ru
SMTP_PASS=app-password-here
# Кому приходят заявки (можно тот же ящик)
MAIL_TO=zayavki@yourdomain.ru

# ─────────────────────────────────────────────────────────────
# Публичный адрес сайта (для sitemap/Open Graph). Без слэша в конце.
# ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://fulfillment-sell.ru
